  evaluatedBy              String?  @map("evaluated_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  createdBy                String?  @map("created_by") @db.Uuid

  credit                   Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
  @@index([riskLevel])
  @@index([evaluatedAt])
