// ============================================================
// ASSEMBLIES & VOTING (Fase I)
// ============================================================

model Assembly {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(30)
  title          String   @db.VarChar(200)
  assemblyType   String   @default("ORDINARIA") @map("assembly_type") @db.VarChar(30)
  status         String   @default("PROGRAMADA") @db.VarChar(30) // PROGRAMADA, ABIERTA, CERRADA, CANCELADA
  scheduledAt    DateTime @map("scheduled_at")
  location       String?  @db.VarChar(200)
  quorumRequired Decimal  @default(50) @map("quorum_required") @db.Decimal(7, 4)
  description    String?  @db.VarChar(1000)
  openedAt       DateTime? @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  agendaItems    AssemblyAgendaItem[]
  attendances    AssemblyAttendance[]
  votes          AssemblyVote[]

  @@index([status])
  @@index([scheduledAt])
  @@map("assemblies")
}

model AssemblyAgendaItem {
  id          String   @id @default(uuid()) @db.Uuid
  assemblyId  String   @map("assembly_id") @db.Uuid
  itemNumber  Int      @map("item_number")
  title       String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  requiresVote Boolean @default(false) @map("requires_vote")
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.Uuid

  assembly    Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  votes       AssemblyVote[]

  @@unique([assemblyId, itemNumber])
  @@index([assemblyId])
  @@map("assembly_agenda_items")
}

model AssemblyAttendance {
  id          String   @id @default(uuid()) @db.Uuid
  assemblyId  String   @map("assembly_id") @db.Uuid
  associateId String   @map("associate_id") @db.Uuid
  status      String   @default("HABILITADO") @db.VarChar(30) // HABILITADO, PRESENTE, AUSENTE, BLOQUEADO
  checkedInAt DateTime? @map("checked_in_at")
  votingWeight Decimal @default(1) @map("voting_weight") @db.Decimal(10, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  assembly    Assembly  @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Restrict)

  @@unique([assemblyId, associateId])
  @@index([assemblyId])
  @@index([associateId])
  @@index([status])
  @@map("assembly_attendances")
}

model AssemblyVote {
  id             String   @id @default(uuid()) @db.Uuid
  assemblyId     String   @map("assembly_id") @db.Uuid
  agendaItemId   String?  @map("agenda_item_id") @db.Uuid
  title          String   @db.VarChar(200)
  description    String?  @db.VarChar(1000)
  voteType       String   @default("MAYORIA_SIMPLE") @map("vote_type") @db.VarChar(40)
  status         String   @default("BORRADOR") @db.VarChar(30) // BORRADOR, ABIERTA, CERRADA, ANULADA
  isSecret       Boolean  @default(false) @map("is_secret")
  openedAt       DateTime? @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  assembly       Assembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  agendaItem     AssemblyAgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  options        AssemblyVoteOption[]
  ballots        AssemblyBallot[]

  @@index([assemblyId])
  @@index([agendaItemId])
  @@index([status])
  @@map("assembly_votes")
}

model AssemblyVoteOption {
  id          String   @id @default(uuid()) @db.Uuid
  voteId      String   @map("vote_id") @db.Uuid
  label       String   @db.VarChar(150)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  vote        AssemblyVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  ballots     AssemblyBallot[]

  @@index([voteId])
  @@map("assembly_vote_options")
}

model AssemblyBallot {
  id          String   @id @default(uuid()) @db.Uuid
  voteId      String   @map("vote_id") @db.Uuid
  optionId    String   @map("option_id") @db.Uuid
  associateId String   @map("associate_id") @db.Uuid
  weight      Decimal  @default(1) @db.Decimal(10, 4)
  castAt      DateTime @default(now()) @map("cast_at")
  castBy      String?  @map("cast_by") @db.Uuid

  vote        AssemblyVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option      AssemblyVoteOption @relation(fields: [optionId], references: [id], onDelete: Restrict)
  associate   Associate @relation(fields: [associateId], references: [id], onDelete: Restrict)

  @@unique([voteId, associateId])
  @@index([voteId])
  @@index([optionId])
  @@index([associateId])
  @@map("assembly_ballots")
}

// ============================================================
// ACCOUNTING - CHART OF ACCOUNTS & JOURNAL ENTRIES (Fase C)
// ============================================================

model ChartAccount {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(30)
  name            String   @db.VarChar(180)
  description     String?  @db.VarChar(500)
  accountType     String   @map("account_type") @db.VarChar(30) // ACTIVO, PASIVO, PATRIMONIO, INGRESO, GASTO, COSTO
  nature          String   @db.VarChar(10) // DEBIT, CREDIT
  parentId        String?  @map("parent_id") @db.Uuid
  level           Int      @default(1)
  isMovement      Boolean  @default(true) @map("is_movement")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  parent          ChartAccount? @relation("ChartAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        ChartAccount[] @relation("ChartAccountHierarchy")
  journalLines    AccountingJournalLine[]
  debitRules      AccountingRule[] @relation("AccountingRuleDebitAccount")
  creditRules     AccountingRule[] @relation("AccountingRuleCreditAccount")
  bankAccounts    BankAccount[]

  @@index([accountType])
  @@index([parentId])
  @@index([isActive])
  @@map("chart_accounts")
}

model AccountingRule {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(60)
  name            String   @db.VarChar(180)
  module          String   @db.VarChar(50)
  event           String   @db.VarChar(80)
  debitAccountId  String   @map("debit_account_id") @db.Uuid
  creditAccountId String   @map("credit_account_id") @db.Uuid
  description     String?  @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  debitAccount    ChartAccount @relation("AccountingRuleDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount   ChartAccount @relation("AccountingRuleCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@unique([module, event])
  @@index([module])
  @@index([event])
  @@index([isActive])
  @@map("accounting_rules")
}

model AccountingJournalEntry {
  id              String   @id @default(uuid()) @db.Uuid
  entryNumber     String   @unique @map("entry_number") @db.VarChar(30)
  entryDate       DateTime @default(now()) @map("entry_date")
  description     String   @db.VarChar(500)
  sourceModule    String?  @map("source_module") @db.VarChar(50)
  sourceEvent     String?  @map("source_event") @db.VarChar(80)
  sourceEntity    String?  @map("source_entity") @db.VarChar(80)
  sourceEntityId  String?  @map("source_entity_id") @db.VarChar(80)
  status          String   @default("CONTABILIZADO") @db.VarChar(30) // BORRADOR, CONTABILIZADO, ANULADO
  totalDebit      Decimal  @default(0) @map("total_debit") @db.Decimal(15, 2)
  totalCredit     Decimal  @default(0) @map("total_credit") @db.Decimal(15, 2)
  postedAt        DateTime @default(now()) @map("posted_at")
  postedBy        String?  @map("posted_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  lines           AccountingJournalLine[]

  @@index([entryDate])
  @@index([sourceModule, sourceEvent])
  @@index([sourceEntity, sourceEntityId])
  @@index([status])
  @@map("accounting_journal_entries")
}

model AccountingJournalLine {
  id              String   @id @default(uuid()) @db.Uuid
  entryId         String   @map("entry_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  associateId     String?  @map("associate_id") @db.Uuid
  lineNumber      Int      @map("line_number")
  description     String?  @db.VarChar(500)
  debit           Decimal  @default(0) @db.Decimal(15, 2)
  credit          Decimal  @default(0) @db.Decimal(15, 2)
  thirdPartyName  String?  @map("third_party_name") @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  entry           AccountingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         ChartAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  associate       Associate?             @relation(fields: [associateId], references: [id], onDelete: SetNull)

  @@unique([entryId, lineNumber])
  @@index([entryId])
  @@index([accountId])
  @@index([associateId])
  @@map("accounting_journal_lines")
}

// ============================================================
// TREASURY & BANK RECONCILIATION (Fase J)
// ============================================================

model BankAccount {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(30)
  bankName        String   @map("bank_name") @db.VarChar(150)
  accountNumber   String   @unique @map("account_number") @db.VarChar(50)
  accountType     String   @map("account_type") @db.VarChar(30) // CORRIENTE, AHORROS
  currency        String   @default("COP") @db.VarChar(10)
  currentBalance  Decimal  @default(0) @map("current_balance") @db.Decimal(15, 2)
  chartAccountId  String?  @map("chart_account_id") @db.Uuid
  contactName     String?  @map("contact_name") @db.VarChar(150)
  contactPhone    String?  @map("contact_phone") @db.VarChar(30)
  contactEmail    String?  @map("contact_email") @db.VarChar(255)
  observations    String?  @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  chartAccount    ChartAccount? @relation(fields: [chartAccountId], references: [id], onDelete: SetNull)
  transactions    BankTransaction[]
  reconciliations BankReconciliation[]

  @@index([bankName])
  @@index([isActive])
  @@map("bank_accounts")
}

model BankTransaction {
  id                String    @id @default(uuid()) @db.Uuid
  bankAccountId     String    @map("bank_account_id") @db.Uuid
  transactionDate   DateTime  @map("transaction_date")
  valueDate         DateTime? @map("value_date")
  reference         String?   @db.VarChar(100)
  description       String    @db.VarChar(500)
  transactionType   String    @map("transaction_type") @db.VarChar(30) // DEBITO, CREDITO
  amount            Decimal   @db.Decimal(15, 2)
  runningBalance    Decimal?  @map("running_balance") @db.Decimal(15, 2)
  thirdPartyName    String?   @map("third_party_name") @db.VarChar(200)
  thirdPartyDoc     String?   @map("third_party_doc") @db.VarChar(30)
  importBatchId     String?   @map("import_batch_id") @db.VarChar(50)
  sourceFile        String?   @map("source_file") @db.VarChar(255)
  reconciliationStatus String @default("PENDIENTE") @map("reconciliation_status") @db.VarChar(30) // PENDIENTE, CONCILIADO, NO_APLICA
  isManual          Boolean   @default(false) @map("is_manual")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid

  bankAccount       BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  reconciliationItems BankReconciliationItem[]

  @@index([bankAccountId])
  @@index([transactionDate])
  @@index([reconciliationStatus])
  @@index([reference])
  @@index([importBatchId])
  @@map("bank_transactions")
}

model BankReconciliation {
  id                 String    @id @default(uuid()) @db.Uuid
  reconciliationNumber String  @unique @map("reconciliation_number") @db.VarChar(30)
  bankAccountId      String    @map("bank_account_id") @db.Uuid
  periodYear         Int       @map("period_year")
  periodMonth        Int       @map("period_month")
  status             String    @default("EN_PROCESO") @db.VarChar(30) // EN_PROCESO, COMPLETADA, CANCELADA
  bankBalance        Decimal   @map("bank_balance") @db.Decimal(15, 2)
  bookBalance        Decimal   @map("book_balance") @db.Decimal(15, 2)
  reconciledBalance  Decimal   @default(0) @map("reconciled_balance") @db.Decimal(15, 2)
  difference         Decimal   @default(0) @db.Decimal(15, 2)
  totalItems         Int       @default(0) @map("total_items")
  matchedItems       Int       @default(0) @map("matched_items")
  unmatchedItems     Int       @default(0) @map("unmatched_items")
  completedAt        DateTime? @map("completed_at")
  observations       String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  bankAccount        BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  items              BankReconciliationItem[]

  @@unique([bankAccountId, periodYear, periodMonth])
  @@index([bankAccountId])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@map("bank_reconciliations")
}

model BankReconciliationItem {
  id                 String   @id @default(uuid()) @db.Uuid
  reconciliationId   String   @map("reconciliation_id") @db.Uuid
  bankTransactionId  String?  @map("bank_transaction_id") @db.Uuid
  journalEntryId     String?  @map("journal_entry_id") @db.VarChar(50)
  matchType          String   @map("match_type") @db.VarChar(30) // AUTO, MANUAL, PARCIAL
  bankAmount         Decimal  @map("bank_amount") @db.Decimal(15, 2)
  bookAmount         Decimal  @default(0) @map("book_amount") @db.Decimal(15, 2)
  difference         Decimal  @default(0) @db.Decimal(15, 2)
  status             String   @default("CONCILIADO") @db.VarChar(30) // CONCILIADO, PENDIENTE_BANCO, PENDIENTE_LIBROS
  observations       String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at")
  createdBy          String?  @map("created_by") @db.Uuid

  reconciliation     BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  bankTransaction    BankTransaction?   @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)

  @@index([reconciliationId])
  @@index([bankTransactionId])
  @@index([status])
  @@map("bank_reconciliation_items")
}

model CashRegister {
  id              String    @id @default(uuid()) @db.Uuid
  code            String    @unique @db.VarChar(30)
  name            String    @db.VarChar(100)
  location        String?   @db.VarChar(200)
  currentBalance  Decimal   @default(0) @map("current_balance") @db.Decimal(15, 2)
  status          String    @default("CERRADA") @db.VarChar(20) // ABIERTA, CERRADA
  openedAt        DateTime? @map("opened_at")
  openedBy        String?   @map("opened_by") @db.Uuid
  closedAt        DateTime? @map("closed_at")
  closedBy        String?   @map("closed_by") @db.Uuid
  openingBalance  Decimal   @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  movements       CashMovement[]

  @@index([status])
  @@index([isActive])
  @@map("cash_registers")
}

model CashMovement {
  id              String   @id @default(uuid()) @db.Uuid
  cashRegisterId  String   @map("cash_register_id") @db.Uuid
  movementNumber  String   @unique @map("movement_number") @db.VarChar(30)
  movementType    String   @map("movement_type") @db.VarChar(30) // APERTURA, CIERRE, INGRESO, EGRESO, ARQUEO
  concept         String   @db.VarChar(200)
  amount          Decimal  @db.Decimal(15, 2)
  previousBalance Decimal  @map("previous_balance") @db.Decimal(15, 2)
  newBalance      Decimal  @map("new_balance") @db.Decimal(15, 2)
  reference       String?  @db.VarChar(100)
  thirdPartyName  String?  @map("third_party_name") @db.VarChar(200)
  observations    String?  @db.VarChar(500)
  performedAt     DateTime @default(now()) @map("performed_at")
  performedBy     String?  @map("performed_by") @db.Uuid

  cashRegister    CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([cashRegisterId])
  @@index([movementType])
  @@index([performedAt])
  @@map("cash_movements")
}
