// CoopManager - Prisma Schema
// Cooperative Management System - Coopeenortol

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  associateId    String?   @unique @map("associate_id") @db.Uuid
  phone          String?   @db.VarChar(30)
  avatarUrl      String?   @map("avatar_url") @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  lastLoginIp    String?   @map("last_login_ip") @db.VarChar(45)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid

  // Relations
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  sessions       Session[]
  associate      Associate? @relation(fields: [associateId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid

  // Relations
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  module      String @db.VarChar(50)
  action      String @db.VarChar(50)
  code        String @unique @db.VarChar(100)
  description String? @db.VarChar(500)

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50) // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  module     String   @db.VarChar(50)
  entity     String?  @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(50)
  dataBefore Json?    @map("data_before")
  dataAfter  Json?    @map("data_after")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  details    String?  @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// PARAMETERIZATION - CATALOGS & SYSTEM CONFIG
// ============================================================

model Catalog {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid

  items CatalogItem[]

  @@map("catalogs")
}

model CatalogItem {
  id          String   @id @default(uuid()) @db.Uuid
  catalogId   String   @map("catalog_id") @db.Uuid
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, code])
  @@map("catalog_items")
}

model SystemConfig {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique @db.VarChar(100)
  value       String  @db.Text
  type        String  @default("string") @db.VarChar(20) // string, number, boolean, json
  module      String  @db.VarChar(50)
  description String? @db.VarChar(500)
  isEditable  Boolean @default(true) @map("is_editable")

  @@map("system_configs")
}

// ============================================================
// PERSONS & ASSOCIATES (Fase 2)
// ============================================================

model Person {
  id              String    @id @default(uuid()) @db.Uuid
  documentType    String    @map("document_type") @db.VarChar(20)  // Ref: TIPO_DOCUMENTO
  documentNumber  String    @unique @map("document_number") @db.VarChar(30)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  secondLastName  String?   @map("second_last_name") @db.VarChar(100)
  gender          String?   @db.VarChar(20)  // Ref: GENERO
  birthDate       DateTime? @map("birth_date")
  maritalStatus   String?   @map("marital_status") @db.VarChar(20)  // Ref: ESTADO_CIVIL
  email           String?   @db.VarChar(255)
  phone           String?   @db.VarChar(30)
  mobilePhone     String?   @map("mobile_phone") @db.VarChar(30)
  address         String?   @db.VarChar(500)
  city            String?   @db.VarChar(100)
  department      String?   @db.VarChar(100)  // Departamento / Provincia
  housingType     String?   @map("housing_type") @db.VarChar(20)  // Ref: TIPO_VIVIENDA
  occupation      String?   @db.VarChar(100)
  employer        String?   @db.VarChar(200)
  jobTitle        String?   @map("job_title") @db.VarChar(100)
  monthlyIncome   Decimal?  @map("monthly_income") @db.Decimal(15, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by") @db.Uuid
  updatedBy       String?   @map("updated_by") @db.Uuid

  // Relations
  associate       Associate?
  beneficiaryOf   Beneficiary[]

  @@index([documentType, documentNumber])
  @@map("persons")
}

model Associate {
  id                String    @id @default(uuid()) @db.Uuid
  personId          String    @unique @map("person_id") @db.Uuid
  associateNumber   String    @unique @map("associate_number") @db.VarChar(20) // ASO-YYYY-NNNN
  status            String    @default("PENDIENTE") @db.VarChar(20) // Ref: ESTADO_ASOCIADO
  admissionDate     DateTime? @map("admission_date")
  withdrawalDate    DateTime? @map("withdrawal_date")
  withdrawalReason  String?   @map("withdrawal_reason") @db.VarChar(500)
  observations      String?   @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid

  // Relations
  person            Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  beneficiaries     Beneficiary[]
  documents         AssociateDocument[]
  history           AssociateHistory[]
  savingsAccounts   SavingsAccount[]
  contributions     Contribution[]
  credits           Credit[]
  payrollDeductionDetails PayrollDeductionDetail[]
  cdatInvestments   CdatInvestment[]
  accountingLines   AccountingJournalLine[]
  portalUsers       User[]

  @@index([status])
  @@index([associateNumber])
  @@map("associates")
}

model Beneficiary {
  id            String   @id @default(uuid()) @db.Uuid
  associateId   String   @map("associate_id") @db.Uuid
  personId      String?  @map("person_id") @db.Uuid
  fullName      String   @map("full_name") @db.VarChar(200)
  relationship  String   @db.VarChar(50)  // Ref: PARENTESCO
  percentage    Decimal  @db.Decimal(5, 2) // 0.00 - 100.00
  phone         String?  @db.VarChar(30)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  associate     Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)
  person        Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@map("beneficiaries")
}

model AssociateDocument {
  id            String   @id @default(uuid()) @db.Uuid
  associateId   String   @map("associate_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(50) // "CEDULA", "SOLICITUD", "PAGARE", etc.
  fileName      String   @map("file_name") @db.VarChar(255)
  filePath      String   @map("file_path") @db.VarChar(500)
  storageProvider String @default("local") @map("storage_provider") @db.VarChar(30)
  storageBucket String?  @map("storage_bucket") @db.VarChar(120)
  checksum      String?  @db.VarChar(128)
  fileSize      Int?     @map("file_size")
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  uploadedAt    DateTime @default(now()) @map("uploaded_at")
  uploadedBy    String?  @map("uploaded_by") @db.Uuid

  // Relations
  associate     Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@map("associate_documents")
}

// ============================================================
// INTEGRATIONS - NOTIFICATIONS (Fase E)
// ============================================================

model NotificationTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(150)
  channel     String   @db.VarChar(30) // EMAIL, WHATSAPP
  subject     String?  @db.VarChar(200)
  body        String   @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String?  @map("created_by") @db.Uuid
  updatedBy   String?  @map("updated_by") @db.Uuid

  notifications NotificationLog[]

  @@index([channel])
  @@index([isActive])
  @@map("notification_templates")
}

model NotificationLog {
  id              String    @id @default(uuid()) @db.Uuid
  templateId      String?   @map("template_id") @db.Uuid
  channel         String    @db.VarChar(30) // EMAIL, WHATSAPP
  recipient       String    @db.VarChar(255)
  subject         String?   @db.VarChar(200)
  body            String    @db.Text
  status          String    @default("PENDIENTE") @db.VarChar(30) // PENDIENTE, ENVIADO, FALLIDO, OMITIDO
  provider        String?   @db.VarChar(50)
  providerMessageId String? @map("provider_message_id") @db.VarChar(120)
  errorMessage    String?   @map("error_message") @db.VarChar(1000)
  metadata        Json?
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  createdBy       String?   @map("created_by") @db.Uuid

  template        NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([channel])
  @@index([status])
  @@index([recipient])
  @@index([createdAt])
  @@map("notification_logs")
}

model AssociateHistory {
  id              String   @id @default(uuid()) @db.Uuid
  associateId     String   @map("associate_id") @db.Uuid
  action          String   @db.VarChar(50) // "CREACION", "CAMBIO_ESTADO", "ACTUALIZACION", etc.
  previousStatus  String?  @map("previous_status") @db.VarChar(20)
  newStatus       String?  @map("new_status") @db.VarChar(20)
  details         String?  @db.VarChar(1000)
  performedBy     String?  @map("performed_by") @db.Uuid
  performedAt     DateTime @default(now()) @map("performed_at")

  // Relations
  associate       Associate @relation(fields: [associateId], references: [id], onDelete: Cascade)

  @@index([associateId])
  @@index([performedAt])
  @@map("associate_history")
}

// ============================================================
// CONTRIBUTIONS & SAVINGS (Fase 3)
// ============================================================

model SavingsAccount {
  id              String   @id @default(uuid()) @db.Uuid
  associateId     String   @map("associate_id") @db.Uuid
  accountType     String   @map("account_type") @db.VarChar(30) // Ref: TIPO_APORTE (ORDINARIO, EXTRAORDINARIO, CUOTA_INGRESO)
  balance         Decimal  @default(0) @db.Decimal(15, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  associate       Associate      @relation(fields: [associateId], references: [id], onDelete: Cascade)
  contributions   Contribution[]

  @@unique([associateId, accountType])
  @@index([associateId])
  @@map("savings_accounts")
}

model Contribution {
  id                String   @id @default(uuid()) @db.Uuid
  associateId       String   @map("associate_id") @db.Uuid
  savingsAccountId  String   @map("savings_account_id") @db.Uuid
  receiptId         String?  @map("receipt_id") @db.Uuid
  type              String   @db.VarChar(30)  // Ref: TIPO_APORTE
  amount            Decimal  @db.Decimal(15, 2)
  periodYear        Int?     @map("period_year")
  periodMonth       Int?     @map("period_month") // 1-12
  paymentMethod     String?  @map("payment_method") @db.VarChar(30) // EFECTIVO, TRANSFERENCIA, NOMINA
  reference         String?  @db.VarChar(100) // Referencia bancaria / comprobante
  observations      String?  @db.VarChar(500)
  status            String   @default("APLICADO") @db.VarChar(20) // APLICADO, ANULADO
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by") @db.Uuid

  // Relations
  associate         Associate      @relation(fields: [associateId], references: [id], onDelete: Cascade)
  savingsAccount    SavingsAccount @relation(fields: [savingsAccountId], references: [id], onDelete: Cascade)
  receipt           PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  payrollDeductionDetails PayrollDeductionDetail[]

  @@index([associateId])
  @@index([savingsAccountId])
  @@index([type])
  @@index([createdAt])
  @@map("contributions")
}

model PaymentReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  receiptNumber   String   @unique @map("receipt_number") @db.VarChar(20) // REC-YYYY-NNNN
  associateId     String   @map("associate_id") @db.Uuid
  totalAmount     Decimal  @map("total_amount") @db.Decimal(15, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(30)
  reference       String?  @db.VarChar(100)
  observations    String?  @db.VarChar(500)
  status          String   @default("ACTIVO") @db.VarChar(20) // ACTIVO, ANULADO
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by") @db.Uuid

  // Relations
  contributions   Contribution[]

  @@index([associateId])
  @@index([createdAt])
  @@map("payment_receipts")
}

// ============================================================
// CREDITS (Fase 4)
// ============================================================

model Credit {
  id                  String    @id @default(uuid()) @db.Uuid
  associateId         String    @map("associate_id") @db.Uuid
  creditNumber        String    @unique @map("credit_number") @db.VarChar(20) // CRE-YYYY-NNNN
  creditLine          String    @map("credit_line") @db.VarChar(30)  // Ref: LINEA_CREDITO
  status              String    @default("SOLICITUD") @db.VarChar(20) // Ref: ESTADO_CREDITO
  requestedAmount     Decimal   @map("requested_amount") @db.Decimal(15, 2)
  approvedAmount      Decimal?  @map("approved_amount") @db.Decimal(15, 2)
  disbursedAmount     Decimal?  @map("disbursed_amount") @db.Decimal(15, 2)
  interestRate        Decimal   @map("interest_rate") @db.Decimal(5, 2)  // Tasa mensual %
  termMonths          Int       @map("term_months")  // Plazo en meses
  paymentFrequency    String    @map("payment_frequency") @db.VarChar(20)  // Ref: PERIODICIDAD
  purpose             String?   @db.VarChar(500)  // Destino del crédito
  guaranteeType       String?   @map("guarantee_type") @db.VarChar(50)  // PERSONAL, CODEUDOR, REAL
  guaranteeDescription String?  @map("guarantee_description") @db.VarChar(500)
  // Fechas del ciclo
  requestDate         DateTime  @default(now()) @map("request_date")
  approvedDate        DateTime? @map("approved_date")
  approvedBy          String?   @map("approved_by") @db.Uuid
  rejectedDate        DateTime? @map("rejected_date")
  rejectionReason     String?   @map("rejection_reason") @db.VarChar(500)
  disbursementDate    DateTime? @map("disbursement_date")
  firstPaymentDate    DateTime? @map("first_payment_date")
  lastPaymentDate     DateTime? @map("last_payment_date")
  // Saldos
  outstandingBalance  Decimal   @default(0) @map("outstanding_balance") @db.Decimal(15, 2)
  totalPaid           Decimal   @default(0) @map("total_paid") @db.Decimal(15, 2)
  totalInterestPaid   Decimal   @default(0) @map("total_interest_paid") @db.Decimal(15, 2)
  // Meta
  observations        String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid

  // Relations
  associate           Associate           @relation(fields: [associateId], references: [id], onDelete: Cascade)
  amortization        AmortizationEntry[]
  payments            CreditPayment[]
  payrollDeductionDetails PayrollDeductionDetail[]

  @@index([associateId])
  @@index([status])
  @@index([creditNumber])
  @@map("credits")
}

model AmortizationEntry {
  id              String   @id @default(uuid()) @db.Uuid
  creditId        String   @map("credit_id") @db.Uuid
  installmentNumber Int    @map("installment_number")
  dueDate         DateTime @map("due_date")
  principalAmount Decimal  @map("principal_amount") @db.Decimal(15, 2)
  interestAmount  Decimal  @map("interest_amount") @db.Decimal(15, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(15, 2)
  remainingBalance Decimal @map("remaining_balance") @db.Decimal(15, 2)
  status          String   @default("PENDIENTE") @db.VarChar(20)  // PENDIENTE, PAGADO, VENCIDO
  paidDate        DateTime? @map("paid_date")
  paidAmount      Decimal?  @map("paid_amount") @db.Decimal(15, 2)

  // Relations
  credit          Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)
  payrollDeductionDetails PayrollDeductionDetail[]

  @@unique([creditId, installmentNumber])
  @@index([creditId])
  @@index([dueDate])
  @@map("amortization_entries")
}

model CreditPayment {
  id              String   @id @default(uuid()) @db.Uuid
  creditId        String   @map("credit_id") @db.Uuid
  paymentNumber   Int      @map("payment_number")
  amount          Decimal  @db.Decimal(15, 2)
  principalPaid   Decimal  @map("principal_paid") @db.Decimal(15, 2)
  interestPaid    Decimal  @map("interest_paid") @db.Decimal(15, 2)
  lateFee         Decimal  @default(0) @map("late_fee") @db.Decimal(15, 2)
  paymentMethod   String   @map("payment_method") @db.VarChar(30)
  reference       String?  @db.VarChar(100)
  observations    String?  @db.VarChar(500)
  paymentDate     DateTime @default(now()) @map("payment_date")
  createdBy       String?  @map("created_by") @db.Uuid

  // Relations
  credit          Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)
  payrollDeductionDetails PayrollDeductionDetail[]

  @@index([creditId])
  @@index([paymentDate])
  @@map("credit_payments")
}

// ============================================================
// PAYROLL DEDUCTIONS / LIBRANZAS (Fase A)
// ============================================================

model PayingEntity {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(30)
  name           String   @db.VarChar(200)
  nit            String?  @db.VarChar(30)
  entityType     String   @map("entity_type") @db.VarChar(30) // SECRETARIA, COLEGIO, UNIVERSIDAD, OTRO
  contactName    String?  @map("contact_name") @db.VarChar(150)
  contactEmail   String?  @map("contact_email") @db.VarChar(255)
  contactPhone   String?  @map("contact_phone") @db.VarChar(30)
  fileFormat     String   @default("CSV") @map("file_format") @db.VarChar(30) // CSV, TXT_FIXED
  separator      String   @default(";") @db.VarChar(5)
  encoding       String   @default("UTF-8") @db.VarChar(20)
  paymentCycle   String   @default("MENSUAL") @map("payment_cycle") @db.VarChar(20)
  cutoffDay      Int?     @map("cutoff_day")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by") @db.Uuid
  updatedBy      String?  @map("updated_by") @db.Uuid

  batches        PayrollDeductionBatch[]

  @@index([entityType])
  @@index([isActive])
  @@map("paying_entities")
}

model PayrollDeductionBatch {
  id                   String    @id @default(uuid()) @db.Uuid
  batchNumber          String    @unique @map("batch_number") @db.VarChar(30)
  payingEntityId       String    @map("paying_entity_id") @db.Uuid
  periodYear           Int       @map("period_year")
  periodMonth          Int       @map("period_month")
  status               String    @default("BORRADOR") @db.VarChar(30) // BORRADOR, GENERADO, ENVIADO, CONCILIACION_PARCIAL, CONCILIADO, ANULADO
  includeContributions Boolean   @default(true) @map("include_contributions")
  includeCredits       Boolean   @default(true) @map("include_credits")
  totalRecords         Int       @default(0) @map("total_records")
  totalAmount          Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  appliedAmount        Decimal   @default(0) @map("applied_amount") @db.Decimal(15, 2)
  rejectedAmount       Decimal   @default(0) @map("rejected_amount") @db.Decimal(15, 2)
  generatedAt          DateTime? @map("generated_at")
  sentAt               DateTime? @map("sent_at")
  conciliatedAt        DateTime? @map("conciliated_at")
  fileName             String?   @map("file_name") @db.VarChar(255)
  fileHash             String?   @map("file_hash") @db.VarChar(128)
  generationMetadata   Json?     @map("generation_metadata")
  conciliationMetadata Json?     @map("conciliation_metadata")
  observations         String?   @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  createdBy            String?   @map("created_by") @db.Uuid
  updatedBy            String?   @map("updated_by") @db.Uuid

  payingEntity         PayingEntity             @relation(fields: [payingEntityId], references: [id], onDelete: Restrict)
  details              PayrollDeductionDetail[]

  @@unique([payingEntityId, periodYear, periodMonth])
  @@index([status])
  @@index([periodYear, periodMonth])
  @@index([payingEntityId])
  @@map("payroll_deduction_batches")
}

model PayrollDeductionDetail {
  id                  String   @id @default(uuid()) @db.Uuid
  batchId             String   @map("batch_id") @db.Uuid
  associateId         String   @map("associate_id") @db.Uuid
  creditId            String?  @map("credit_id") @db.Uuid
  amortizationEntryId String?  @map("amortization_entry_id") @db.Uuid
  contributionId      String?  @map("contribution_id") @db.Uuid
  creditPaymentId     String?  @map("credit_payment_id") @db.Uuid
  lineNumber          Int      @map("line_number")
  documentType        String   @map("document_type") @db.VarChar(20)
  documentNumber      String   @map("document_number") @db.VarChar(30)
  associateNumber     String   @map("associate_number") @db.VarChar(20)
  fullName            String   @map("full_name") @db.VarChar(250)
  payrollCode         String?  @map("payroll_code") @db.VarChar(50)
  conceptCode         String   @map("concept_code") @db.VarChar(50)
  conceptType         String   @map("concept_type") @db.VarChar(30) // APORTE, CREDITO
  amount              Decimal  @db.Decimal(15, 2)
  appliedAmount       Decimal  @default(0) @map("applied_amount") @db.Decimal(15, 2)
  rejectedAmount      Decimal  @default(0) @map("rejected_amount") @db.Decimal(15, 2)
  status              String   @default("PENDIENTE") @db.VarChar(30) // PENDIENTE, ENVIADO, APLICADO, RECHAZADO, PARCIAL, ANULADO
  rejectionReason     String?  @map("rejection_reason") @db.VarChar(500)
  sourcePayload       Json?    @map("source_payload")
  conciliationPayload Json?    @map("conciliation_payload")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           String?  @map("created_by") @db.Uuid
  updatedBy           String?  @map("updated_by") @db.Uuid

  batch               PayrollDeductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  associate           Associate             @relation(fields: [associateId], references: [id], onDelete: Restrict)
  credit              Credit?               @relation(fields: [creditId], references: [id], onDelete: SetNull)
  amortizationEntry   AmortizationEntry?    @relation(fields: [amortizationEntryId], references: [id], onDelete: SetNull)
  contribution        Contribution?         @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  creditPayment       CreditPayment?        @relation(fields: [creditPaymentId], references: [id], onDelete: SetNull)

  @@unique([batchId, lineNumber])
  @@index([batchId])
  @@index([associateId])
  @@index([documentNumber])
  @@index([status])
  @@index([conceptType])
  @@map("payroll_deduction_details")
}

// ============================================================
// CDATS - TERM DEPOSIT CERTIFICATES (Fase B)
// ============================================================

model CdatProduct {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique @db.VarChar(30)
  name             String   @db.VarChar(150)
  description      String?  @db.VarChar(500)
  minAmount        Decimal  @map("min_amount") @db.Decimal(15, 2)
  maxAmount        Decimal? @map("max_amount") @db.Decimal(15, 2)
  minTermDays      Int      @map("min_term_days")
  maxTermDays      Int?     @map("max_term_days")
  annualRate       Decimal  @map("annual_rate") @db.Decimal(7, 4)
  interestMode     String   @default("SIMPLE") @map("interest_mode") @db.VarChar(20) // SIMPLE, COMPOUND
  paymentFrequency String   @default("VENCIMIENTO") @map("payment_frequency") @db.VarChar(30)
  withholdingRate  Decimal  @default(0) @map("withholding_rate") @db.Decimal(7, 4)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  investments      CdatInvestment[]

  @@index([isActive])
  @@map("cdat_products")
}

model CdatInvestment {
  id                 String    @id @default(uuid()) @db.Uuid
  certificateNumber  String    @unique @map("certificate_number") @db.VarChar(30)
  associateId        String    @map("associate_id") @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  principalAmount    Decimal   @map("principal_amount") @db.Decimal(15, 2)
  annualRate         Decimal   @map("annual_rate") @db.Decimal(7, 4)
  termDays           Int       @map("term_days")
  startDate          DateTime  @map("start_date")
  maturityDate       DateTime  @map("maturity_date")
  expectedInterest   Decimal   @map("expected_interest") @db.Decimal(15, 2)
  withholdingAmount  Decimal   @default(0) @map("withholding_amount") @db.Decimal(15, 2)
  netInterest        Decimal   @map("net_interest") @db.Decimal(15, 2)
  status             String    @default("ACTIVO") @db.VarChar(30) // ACTIVO, VENCIDO, LIQUIDADO, CANCELADO
  renewalPolicy      String    @default("NO_RENUEVA") @map("renewal_policy") @db.VarChar(30)
  redeemedAt         DateTime? @map("redeemed_at")
  cancelledAt        DateTime? @map("cancelled_at")
  observations       String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid

  associate          Associate        @relation(fields: [associateId], references: [id], onDelete: Restrict)
  product            CdatProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements          CdatMovement[]

  @@index([associateId])
  @@index([productId])
  @@index([status])
  @@index([maturityDate])
  @@map("cdat_investments")
}

model CdatMovement {
  id             String   @id @default(uuid()) @db.Uuid
  investmentId   String   @map("investment_id") @db.Uuid
  movementType   String   @map("movement_type") @db.VarChar(30) // APERTURA, VENCIMIENTO, LIQUIDACION, CANCELACION
  principalAmount Decimal @default(0) @map("principal_amount") @db.Decimal(15, 2)
  interestAmount Decimal  @default(0) @map("interest_amount") @db.Decimal(15, 2)
  withholdingAmount Decimal @default(0) @map("withholding_amount") @db.Decimal(15, 2)
  netAmount      Decimal  @default(0) @map("net_amount") @db.Decimal(15, 2)
  reference      String?  @db.VarChar(100)
  observations   String?  @db.VarChar(500)
  performedAt    DateTime @default(now()) @map("performed_at")
  performedBy    String?  @map("performed_by") @db.Uuid

  investment     CdatInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
  @@index([movementType])
  @@index([performedAt])
  @@map("cdat_movements")
}

// ============================================================
// ACCOUNTING - CHART OF ACCOUNTS & JOURNAL ENTRIES (Fase C)
// ============================================================

model ChartAccount {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(30)
  name            String   @db.VarChar(180)
  description     String?  @db.VarChar(500)
  accountType     String   @map("account_type") @db.VarChar(30) // ACTIVO, PASIVO, PATRIMONIO, INGRESO, GASTO, COSTO
  nature          String   @db.VarChar(10) // DEBIT, CREDIT
  parentId        String?  @map("parent_id") @db.Uuid
  level           Int      @default(1)
  isMovement      Boolean  @default(true) @map("is_movement")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  parent          ChartAccount? @relation("ChartAccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children        ChartAccount[] @relation("ChartAccountHierarchy")
  journalLines    AccountingJournalLine[]
  debitRules      AccountingRule[] @relation("AccountingRuleDebitAccount")
  creditRules     AccountingRule[] @relation("AccountingRuleCreditAccount")

  @@index([accountType])
  @@index([parentId])
  @@index([isActive])
  @@map("chart_accounts")
}

model AccountingRule {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(60)
  name            String   @db.VarChar(180)
  module          String   @db.VarChar(50)
  event           String   @db.VarChar(80)
  debitAccountId  String   @map("debit_account_id") @db.Uuid
  creditAccountId String   @map("credit_account_id") @db.Uuid
  description     String?  @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  debitAccount    ChartAccount @relation("AccountingRuleDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount   ChartAccount @relation("AccountingRuleCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)

  @@unique([module, event])
  @@index([module])
  @@index([event])
  @@index([isActive])
  @@map("accounting_rules")
}

model AccountingJournalEntry {
  id              String   @id @default(uuid()) @db.Uuid
  entryNumber     String   @unique @map("entry_number") @db.VarChar(30)
  entryDate       DateTime @default(now()) @map("entry_date")
  description     String   @db.VarChar(500)
  sourceModule    String?  @map("source_module") @db.VarChar(50)
  sourceEvent     String?  @map("source_event") @db.VarChar(80)
  sourceEntity    String?  @map("source_entity") @db.VarChar(80)
  sourceEntityId  String?  @map("source_entity_id") @db.VarChar(80)
  status          String   @default("CONTABILIZADO") @db.VarChar(30) // BORRADOR, CONTABILIZADO, ANULADO
  totalDebit      Decimal  @default(0) @map("total_debit") @db.Decimal(15, 2)
  totalCredit     Decimal  @default(0) @map("total_credit") @db.Decimal(15, 2)
  postedAt        DateTime @default(now()) @map("posted_at")
  postedBy        String?  @map("posted_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by") @db.Uuid
  updatedBy       String?  @map("updated_by") @db.Uuid

  lines           AccountingJournalLine[]

  @@index([entryDate])
  @@index([sourceModule, sourceEvent])
  @@index([sourceEntity, sourceEntityId])
  @@index([status])
  @@map("accounting_journal_entries")
}

model AccountingJournalLine {
  id              String   @id @default(uuid()) @db.Uuid
  entryId         String   @map("entry_id") @db.Uuid
  accountId       String   @map("account_id") @db.Uuid
  associateId     String?  @map("associate_id") @db.Uuid
  lineNumber      Int      @map("line_number")
  description     String?  @db.VarChar(500)
  debit           Decimal  @default(0) @db.Decimal(15, 2)
  credit          Decimal  @default(0) @db.Decimal(15, 2)
  thirdPartyName  String?  @map("third_party_name") @db.VarChar(200)
  createdAt       DateTime @default(now()) @map("created_at")

  entry           AccountingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         ChartAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  associate       Associate?             @relation(fields: [associateId], references: [id], onDelete: SetNull)

  @@unique([entryId, lineNumber])
  @@index([entryId])
  @@index([accountId])
  @@index([associateId])
  @@map("accounting_journal_lines")
}
